# Required — the SQLCipher key for the encrypted database. The app fails fast on
# startup if this is missing. Use a long random value in any real deployment.
DB_ENCRYPTION_KEY=change-me

# Optional — all have sensible defaults.
# DB_PATH=./data/forms.db          # ":memory:" for an ephemeral unencrypted DB
# PORT=3000
# RETRY_MAX_ATTEMPTS=3             # in-pipeline retries for geocode / email
# RETRY_BASE_DELAY_MS=200         # exponential backoff base: delay * 2^(n-1)
# SWEEP_INTERVAL_MS=5000          # interval safety-net sweep cadence
# STALE_LOCK_MS=30000             # how long a claimed row may sit before reclaim
# AUTO_TRIGGER_CONSUMER=true      # kick the consumer immediately after each ingest
